# PostgreSQL. Скопируй в .env и подставь свои данные
# DATABASE_URL=postgresql://пользователь:пароль@localhost:5432/schedule_db

# Варианты:
# 1) Стандартный пользователь postgres:
#    DATABASE_URL=postgresql://postgres:stef4587@localhost:5432/schedule_db

# 2) macOS Homebrew (часто без пароля, peer auth):
#    DATABASE_URL=postgresql://localhost:5432/schedule_db

# 3) Твой системный пользователь:
#    DATABASE_URL=postgresql://stefanrozkov@localhost:5432/schedule_db
